<% if @debug_mode %>
<div class="debug">
    <strong>Debug links:</strong>
    <%= link_to 'nuffle', "https://nuffle.xyz/teams/#{@team.api_id}", target: '_blank' %>
    <%= link_to 'cyanide', @team.cyanide_uri, target: '_blank' %>
    <%= button_to "Refresh", refresh_team_path(@team), method: :post, style: 'display: inline;' %>
</div>
<% end %>
<%= image_tag @team.logo_url, alt: "#{@team.name} logo", style: "max-width: 140px; max-height: 140px; float: right; margin-top: 30px;" if @team.logo_url %>

<h1>
    <%= @team.name %>

    <span><%= @team.platform %></span>
    <span><%= @team.game_version %></span>

</h1>

Coach: <%= link_to @team.coach.name, @team.coach if @team.coach %>
Race: <%= @team.race %>

<h2>Lifetime Record</h2>
<% if @team.lifetime_stat && @team.lifetime_stat.matches.to_i > 0 %>
  <% lifetime = @team.lifetime_stat %>
  <table class="centered">
    <thead>
      <tr>
        <th>P</th>
        <th>W</th>
        <th>D</th>
        <th>L</th>
        <th>Pts</th>
        <th>TD+</th>
        <th>TD-</th>
        <th>CAS+</th>
        <th>CAS-</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><%= lifetime.matches %></td>
        <td><%= lifetime.wins %></td>
        <td><%= lifetime.draws %></td>
        <td><%= lifetime.losses %></td>
        <td><%= lifetime.points %></td>
        <td>+<%= lifetime.touchdowns_made %></td>
        <td>-<%= lifetime.touchdowns_sustained %></td>
        <td>+<%= lifetime.casualties_made %></td>
        <td>-<%= lifetime.casualties_sustained %></td>
      </tr>
    </tbody>
  </table>
<% else %>
  <p>No lifetime record yet.</p>
<% end %>

<h2>Roster</h2>
<% if @current_roster.any? %>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Player</th>
        <th>Position</th>
        <th>Skills</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @current_roster.each do |match_player| %>
        <tr>
          <td><%= match_player.player.number %></td>
          <td nowrap><%= link_to match_player.name, match_player.player %></td>
          <td><%= match_player.kind %></td>
          <td><%= match_player.skills&.any? ? match_player.skills.join(", ") : "—" %></td>
          <td><% if match_player.player.status == "mng" %><span title="Miss next game">mng</span><% end %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No roster data yet.</p>
<% end %>

<h2>Departed</h2>
<% if @departed_roster.any? %>
  <table class="departed">
    <thead>
      <tr>
        <th>#</th>
        <th>Player</th>
        <th>Position</th>
        <th>Skills</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @departed_roster.each do |match_player| %>
        <tr>
          <td><%= match_player.player.number %></td>
          <td><%= link_to match_player.name, match_player.player %></td>
          <td><%= match_player.kind %></td>
          <td><%= match_player.skills&.any? ? match_player.skills.join(", ") : "—" %></td>
          <td><%= match_player.player.status == "dead" ? "dead" : "fired" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No departed players.</p>
<% end %>

<h2>Upcoming Matches</h2>
<% if @upcoming_contests.any? %>
  <% @upcoming_contests.group_by(&:competition).each do |competition, contests| %>
    <h3><%= link_to competition.name, competition %></h3>
    <ul>
      <% contests.each do |contest| %>
        <li>
          <% if contest.live? %>
            <span class="badge badge-active">Live</span>
          <% end %>
          <%= "#{contest.match_date.strftime("%B %d, %Y")}:" if contest.match_date %>
          <%= link_to @team.name, @team %>
          vs
          <% opponent = contest.home_team_id == @team.id ? contest.away_team : contest.home_team %>
          <% if opponent %>
            <%= link_to opponent.name, opponent %>
          <% else %>
            N/A
          <% end %>
          <% if contest.round %>
            (Round <%= contest.round %>)
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <p>No upcoming matches.</p>
<% end %>

<h2>Match History</h2>
<% if @matches_by_competition.any? %>
  <% @matches_by_competition.each do |competition, matches| %>
    <h3><%= link_to competition.name, competition %></h3>
    <ul>
      <% matches.sort_by { |m| -(m.started || Time.at(0)).to_f }.each do |match| %>
        <% our_mt = match.match_teams.find { |mt| mt.team_id == @team.id } %>
        <% opp_mt = match.match_teams.find { |mt| mt.team_id != @team.id } %>
        <li>
          <%= link_to match.started&.strftime("%B %d, %Y") || "TBD", match %>:
          <%= link_to our_mt.team.name, our_mt.team %>
          <% if opp_mt %>
            <%= link_to "#{our_mt.score} - #{opp_mt.score}", match %>
            <%= link_to opp_mt.team.name, opp_mt.team %>
          <% else %>
            vs TBD
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <p>No matches yet.</p>
<% end %>
