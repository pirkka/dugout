<h1><%= @series.name %></h1>

<div class="debug">
  <strong>Debug links:</strong>
  <%= link_to "league: #{@series.league.name}", @series.league %>
  <%= link_to "Edit", edit_series_path(@series.slug) %>
  <%= button_to "Refresh standings", refresh_series_path(@series.slug), method: :post, style: 'display: inline;' %>
</div>

<h2>Standings</h2>
<% if @series.series_teams.any? %>
  <table>
    <thead>
      <tr>
        <th>Pos</th>
        <th>Team</th>
        <th></th>
        <th>Pts</th>
        <th>Pld</th>
        <th>W</th>
        <th>D</th>
        <th>L</th>
        <th colspan="2" nowrap>TD</th>
        <th colspan="2" nowrap>Cas</th>
      </tr>
    </thead>
    <% playoff_cutoff = @series.playoff_cutoff&.to_i %>
    <tbody>
      <% @series.series_teams.each do |st| %>
        <tr>
          <td><%= st.position %></td>
          <td nowrap><%= link_to st.team.name, st.team %> <span><%= st.team.race %></span></td>
          <td>
            <%= image_tag st.team.logo_url, alt: 'logo', width: 32, height: 32 %>
          </td>
          <td><%= st.points %></td>
          <td><%= st.matches %></td>
          <td><%= st.wins %></td>
          <td><%= st.draws %></td>
          <td><%= st.losses %></td>
          <td>+<%= st.touchdowns_made %></td>
          <td>-<%= st.touchdowns_sustained %></td>
          <td>+<%= st.casualties_made %></td>
          <td>-<%= st.casualties_sustained %></td>
        </tr>
        <% if playoff_cutoff && st.position == playoff_cutoff %>
        <tr class="cutoff-row">
          <td colspan="100%" style="padding:0; height:0;">
            <div class="cutoff-line"></div>
          </td>
        </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No standings yet. Click "Refresh standings" to calculate.</p>
<% end %>

<h2>Matches</h2>
<% if @series.competitions.any? %>
  <% @series.competitions.each do |comp| %>
    <h3>
      <%= link_to comp.name, comp %>
      <span><%= comp.format.gsub('_',' ') %></span>
    </h3>
    <% if comp.contests.any? %>
      <h4>Upcoming</h4>
      <ul>
        <% comp.contests.order(:match_date, :round).each do |contest| %>
          <li>
            <%= contest.match_date ? contest.match_date.strftime("%B %d, %Y") + ":" : "TBA" %>
            <% if contest.home_team %>
              <%= link_to contest.home_team.name, contest.home_team %>
            <% else %>
              N/A
            <% end %>
            vs
            <% if contest.away_team %>
              <%= link_to contest.away_team.name, contest.away_team %>
            <% else %>
              N/A
            <% end %>
            <% if contest.round %>
              (Round <%= contest.round %>)
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if comp.matches.any? %>
      <% matches_by_round = comp.matches.sort_by { |m| -(m.started || Time.at(0)).to_f }.group_by(&:round) %>
      <% has_rounds = matches_by_round.keys.any? %>
      <% (has_rounds ? matches_by_round.keys.sort_by { |r| r ? -r : -Float::INFINITY } : [nil]).each do |round| %>
        <% if has_rounds %>
          <h4><%= round ? "Round #{round}" : "Round TBD" %></h4>
        <% end %>
        <ul>
          <% matches_by_round[round].each do |match| %>
            <% mts = match.match_teams.sort_by(&:id) %>
            <li>
              <%= link_to mts[0].team.name, mts[0].team %>
              vs
              <% if mts[1] %>
                <%= link_to mts[1].team.name, mts[1].team %>
              <% else %>
                N/A
              <% end %>
              <%= link_to "#{mts[0].score} - #{mts[1]&.score ||0}", match %>
              <% if match.replay_json.present? %>
                *
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% else %>
      <p>No matches yet.</p>
    <% end %>
  <% end %>
<% else %>
  <p>No competitions yet.</p>
<% end %>
