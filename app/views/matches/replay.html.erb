<% replay = @match.replay_json %>
<% info = replay["info"] %>
<% game = replay["game"] %>
<% teams = replay["teams"] %>
<% players = replay["players"] %>

<h1>Replay: <%= teams.values.map { |t| t["name"] }.compact.join(" vs ") %></h1>

<p>
  <%= link_to "Back to match", @match %> |
  <%= link_to "cyanide match", @match.cyanide_match_uri, target: '_blank' %>
</p>

<h2>Highlights</h2>
<table>
  <tr><th>Turn</th><th>Player</th><th>Location</th><th>Type</th><th>Details</th></tr>
<% @match.highlights.each do |h| %>
  <tr>
  <td nowrap>
  <%= h.turn %>/<%= h.team %>
  </td>
  <td>
    <%= h.match_player&.name %>
  </td>
  <td nowrap>
    <%= h.to && h.to.values.join(',') %>
    ➡️
    <%= h.new_position && h.new_position.values.join(',') %>
  </td>
  <td>
  <%= h.event %>
  </td>
  <td>
  <% if h.event == 'injury_caused' %>
      <%= h.injured_match_player&.name %> <%= h.data&.dig('injury_type') %>
  <% end %>
  </td>
  </tr>
<% end %>
</table>
