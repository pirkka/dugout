
<h1>
<%= link_to @match.away_team&.name || 'n/a', @match.away_team %>
vs
<%= link_to @match.home_team&.name, @match.home_team %>
</h1>

<p>
<% if @match.finished %>
  <strong>Finished:</strong> <%= @match.finished.in_time_zone("Helsinki").strftime("%d.%m.%Y %H:%M") %>
  <br>
<% end %>
<strong>Match hash:</strong> <%= @match.calculate_match_hash %>
</p>


<% if @debug_mode %>
<p>
    <b>Debug links:</b>
    <%= link_to "cyanide match", @match.cyanide_match_uri, target: '_blank' %>
</p>
<% end %>

<h2>Team Stats</h2>
<% mts = @match.match_teams.sort_by { |mt| mt.home ? 1 : 0 } %>
<% if mts.all? { |mt| mt.api_data } %>
  <table style="font-size: 2em;">
    <thead>
      <tr>
        <th style="font-size: 0.5em;">Stat</th>
        <% mts.each do |mt| %>
          <th style="font-size: 0.5em;"><%= link_to mt.team.name, mt.team %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <tr><td style="font-size: 0.6em;">Touchdowns</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedtouchdowns"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Casualties inflicted</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedcasualties"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Casualties sustained</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["sustainedcasualties"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Passes</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedpasses"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Catches</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedcatches"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Interceptions</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedinterceptions"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Tackles</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedtackles"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Meters running</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedmetersrunning"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Meters passing</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedmeterspassing"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">KO inflicted</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedko"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Injuries inflicted</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedinjuries"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Dead inflicted</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflicteddead"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">KO sustained</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["sustainedko"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Injuries sustained</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["sustainedinjuries"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Dead sustained</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["sustaineddead"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Pushouts</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["inflictedpushouts"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Expulsions</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["sustainedexpulsions"] %></td><% end %></tr>
      <tr><td style="font-size: 0.6em;">Value</td><% mts.each do |mt| %><td style="text-align: center; font-size: 0.6em;"><%= mt.api_data["value"] %></td><% end %></tr>
    </tbody>
  </table>
<% else %>
  <% @match.match_teams.sort_by(&:id).each do |mt| %>
    <h3><%= link_to mt.team.name, mt.team %></h3>
    <% if mt.api_data %>
      <table>
        <tr><td>Touchdowns</td><td><%= mt.api_data["inflictedtouchdowns"] %></td></tr>
        <tr><td>Casualties inflicted</td><td><%= mt.api_data["inflictedcasualties"] %></td></tr>
        <tr><td>Casualties sustained</td><td><%= mt.api_data["sustainedcasualties"] %></td></tr>
        <tr><td>Passes</td><td><%= mt.api_data["inflictedpasses"] %></td></tr>
        <tr><td>Catches</td><td><%= mt.api_data["inflictedcatches"] %></td></tr>
        <tr><td>Interceptions</td><td><%= mt.api_data["inflictedinterceptions"] %></td></tr>
        <tr><td>Tackles</td><td><%= mt.api_data["inflictedtackles"] %></td></tr>
        <tr><td>Meters running</td><td><%= mt.api_data["inflictedmetersrunning"] %></td></tr>
        <tr><td>Meters passing</td><td><%= mt.api_data["inflictedmeterspassing"] %></td></tr>
        <tr><td>KO inflicted</td><td><%= mt.api_data["inflictedko"] %></td></tr>
        <tr><td>Injuries inflicted</td><td><%= mt.api_data["inflictedinjuries"] %></td></tr>
        <tr><td>Dead inflicted</td><td><%= mt.api_data["inflicteddead"] %></td></tr>
        <tr><td>KO sustained</td><td><%= mt.api_data["sustainedko"] %></td></tr>
        <tr><td>Injuries sustained</td><td><%= mt.api_data["sustainedinjuries"] %></td></tr>
        <tr><td>Dead sustained</td><td><%= mt.api_data["sustaineddead"] %></td></tr>
        <tr><td>Pushouts</td><td><%= mt.api_data["inflictedpushouts"] %></td></tr>
        <tr><td>Expulsions</td><td><%= mt.api_data["sustainedexpulsions"] %></td></tr>
        <tr><td>Team Value</td><td><%= mt.api_data["value"] %></td></tr>
      </table>
    <% end %>
  <% end %>
<% end %>

<h2>Highlights</h2>
<% if @match.replay_json.present? %>
    <% @match.key_highlights.each do |h| %>
      <p>
          turn <%= h.turn %>
            <%= h.event.tr('_','') %>
            <%= h.match_player&.name %>
      </p>
    <% end %>
<% end %>


<h2>Replay Data</h2>
<% if @match.replay? %>
  <p>Replay file: <%= @match.replay_file_name %></p>
  <%= button_to "Parse Replay", parse_replay_match_path(@match), method: :post, style: "font-family: Verdana; font-size: 14px; padding: 4px 8px; cursor: pointer; background: #602900; color: white; border: none; border-radius: 4px; margin-bottom: 8px;" %>
<% end %>
<% if @match.replay_json.present? %>
  <p><%= link_to "View Replay Data", match_replay_path(@match) %></p>
<% end %>
<%= form_tag upload_replay_match_path(@match), multipart: true, style: "font-size: 18px;" do %>
  <%= file_field_tag :replay, accept: ".bbr", style: "font-family: Verdana; font-size: 14px;" %>
  <%= submit_tag "Upload", style: "font-family: Verdana; font-size: 14px; padding: 4px 8px; cursor: pointer; background: #602900; color: white; border: none; border-radius: 4px;" %>
<% end %>

<%= form_tag upload_replay_json_match_path(@match), multipart: true, style: "font-size: 18px; margin-top: 8px;" do %>
  <%= file_field_tag :replay_json, accept: ".json", style: "font-family: Verdana; font-size: 14px;" %>
  <%= button_tag "Upload JSON", style: "font-family: Verdana; font-size: 14px; padding: 4px 8px; cursor: pointer; background: #602900; color: white; border: none; border-radius: 4px;" %>
<% end %>
