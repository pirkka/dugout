<% if @debug_mode %>
<div class="debug">
    <strong>Debug links:</strong>
    <%= link_to 'nuffle', "https://nuffle.xyz/leaderboards/#{@competition.api_id}", target: '_blank' %>
    <%= link_to 'cya-teams', @competition.cyanide_teams_uri, target: '_blank' %>
    <%= link_to 'cya-standings', @competition.cyanide_standings_uri, target: '_blank' %>
    <%= link_to 'cya-matches', @competition.cyanide_matches_uri, target: '_blank' %>
    <%= link_to 'cya-contests', @competition.cyanide_contests_uri, target: '_blank' %>
    <%= link_to 'cya-coaches', @competition.cyanide_coaches_uri, target: '_blank' %>
    <%= button_to "Refresh", refresh_competition_path(@competition), method: :post, style: 'display: inline;' %>
</div>
<% end %>

<h1><%= @competition.name %>

<span><%= @competition.format.gsub('_', ' ') %></span>
<span><%= @competition.platform %></span>
<span><%= @competition.status %></span>
<span><%= @competition.league.game_version %></span>
<%= button_to "♻", refresh_competition_path(@competition), method: :post, class: 'refresh-button' %>

<div class="popup-menu" data-controller="popup-menu">
  <button class="popup-menu__trigger" data-action="click->popup-menu#toggle">⚙</button>
  <div class="popup-menu__dropdown" data-popup-menu-target="menu">
    <% if @competition.series %>
      <%= button_to "Switch Series (#{@competition.series.name})", add_competition_to_series_path(@competition, series_id: @competition.series.id), method: :post %>
    <% else %>
      <%= button_to "Add To Series", add_competition_to_series_path(@competition, new_series_name: ""), method: :post %>
    <% end %>
    <% @series_list.each do |series| %>
      <%= button_to series.name, add_competition_to_series_path(@competition, series_id: series.id), method: :post %>
    <% end %>
    <hr style="margin: 4px 0; border: none; border-top: 1px solid #602900;">
    <%= form_tag add_competition_to_series_path(@competition), method: :post, style: "padding: 4px;" do %>
      <%= text_field_tag :new_series_name, nil, placeholder: "New series name", style: "width: 100%; box-sizing: border-box; font-family: Verdana; font-size: 13px; padding: 4px;" %>
      <%= submit_tag "Create & Add", style: "width: 100%; margin-top: 4px; font-family: Verdana; font-size: 13px; padding: 4px; cursor: pointer;" %>
    <% end %>
  </div>
</div>

<h2>Standings</h2>
<% if @competition.competition_teams.any? %>
  <table>
    <thead>
      <tr>
        <th></th>
        <th>Team</th>
        <th></th>
        <th>Pts</th>
        <th>Pld</th>
        <th>W</th>
        <th>D</th>
        <th>L</th>
        <th colspan="2" nowrap>TD</th>
        <th colspan="2" nowrap>Cas</th>
        <th>Team Value</th>
      </tr>
    </thead>
    <tbody>
      <% playoff_cutoff = @competition.settings&.dig("playoff_cutoff")&.to_i %>
      <% @competition.competition_teams.includes(:team).each do |ct| %>
        <tr>
          <td style="text-align: center;"><%= ct.position %></td>
          <td>
            <%= link_to ct.team.name, ct.team %> <span><%= ct.team.race %></span></td>
          <td>
            <%= image_tag ct.team.logo_url, alt: ct.team.name, width: 32, height: 32 %>
          </td>
          <td style="text-align: center;"><%= @competition.format == :ladder ? ct.score : ct.points %></td>
          <td style="text-align: center;"><%= ct.matches %></td>
          <td style="text-align: center;"><%= ct.wins %></td>
          <td style="text-align: center;"><%= ct.draws %></td>
          <td style="text-align: center;"><%= ct.losses %></td>
          <td style="text-align: center;">+<%= ct.touchdowns_made %></td>
          <td style="text-align: center;">-<%= ct.touchdowns_sustained %></td>
          <td style="text-align: center;">+<%= ct.casualties_made %></td>
          <td style="text-align: center;">-<%= ct.casualties_sustained %></td>
          <td style="text-align: center;"><%= ct.team.value %></td>
        </tr>
        <% if playoff_cutoff && ct.position == playoff_cutoff %>
        <tr class="cutoff-row">
          <td colspan="100%" style="padding:0; height:0;">
            <div class="cutoff-line"></div>
          </td>
        </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No teams yet.</p>
<% end %>
<h2>Upcoming Matches</h2>

<% contests_by_round = @competition.contests.order(:match_date).group_by(&:round) %>
<% has_rounds = contests_by_round.keys.any? %>
<% (has_rounds ? contests_by_round.keys.sort_by { |r| r || Float::INFINITY } : [nil]).each do |round| %>
    <% if has_rounds && contests_by_round[round].any? %>
    <h4><%= round ? "Round #{round}" : "Round TBD" %></h4>
    <ul>
        <% contests_by_round[round].each do |contest| %>
        <% home_team = contest.home_team %>
        <% away_team = contest.away_team %>
        <% home_value = home_team&.value %>
        <% away_value = away_team&.value %>
        <li>
            <%= "#{contest.match_date.strftime("%B %d, %Y")}:" if contest.match_date %>
            <% if home_team %>
            <%= link_to home_team.name, home_team %>
            <% else %>
            N/A
            <% end %>
            vs
            <% if away_team %>
            <%= link_to away_team.name, away_team %>
            <% if home_value && away_value %>
            <small>±<%= (home_value - away_value).abs %></small>
            <% end %>
            <% else %>
            N/A
            <% end %>
        </li>
        <% end %>
    </ul>
    <% end %>
<% end %>

<h2>Finished Matches</h2>

<% if @competition.matches.any? %>
  <% matches_by_round = @competition.matches.sort_by { |m| -(m.started || Time.at(0)).to_f }.group_by(&:round) %>
  <% has_rounds = matches_by_round.keys.any? %>
  <% (has_rounds ? matches_by_round.keys.sort_by { |r| r ? -r : -Float::INFINITY } : [nil]).each do |round| %>
    <% if has_rounds %>
      <h4><%= round ? "Round #{round}" : "Round TBD" %></h4>
    <% end %>
    <ul>
      <% matches_by_round[round].each do |match| %>
        <% mts = match.match_teams.sort_by(&:id) %>
        <li>
          <%= link_to match.started&.strftime("%B %d, %Y") || "TBD", match %>:
          <%= link_to mts[0].team.name, mts[0].team %>
          vs
          <% if mts[1] %>
            <%= link_to mts[1].team.name, mts[1].team %>
          <% else %>
            N/A
          <% end %>
          <%= link_to "#{mts[0].score} - #{mts[1]&.score ||0}", match %>
          <% if match.replay_json.present? %>
            *
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <p>No matches yet.</p>
<% end %>
